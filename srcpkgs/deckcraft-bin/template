# Template file for 'deckcraft-bin'
pkgname=deckcraft-bin
version=0.11.1
revision=1
archs="x86_64"
_name=deckcraft-${version}-linux-x86_64
wrksrc="${_name}"
# windowing (X11/Wayland, xkbcommon) and GPU (Vulkan/EGL) are dlopen'd at runtime
depends="libxkbcommon vulkan-loader libglvnd libX11 libXcursor libXi libXrandr
 wayland xdg-desktop-portal"
short_desc="Open-source native slide deck app, clean-room PowerPoint reimplementation (binary)"
maintainer="pharacox <solocco@users.noreply.github.com>"
license="MIT OR Apache-2.0"
homepage="https://github.com/storytold/deckcraft"
distfiles="${homepage}/releases/download/v${version}/${_name}.tar.gz"
checksum="7bf57a10a4fcf7673ecb669b64e0e545475780ef3e4ee6bf603aeb00f544e69c"
conflicts="deckcraft"
nostrip=yes # prebuilt, already stripped upstream

case "$XBPS_TARGET_MACHINE" in
	*-musl) broken="upstream binaries are built against glibc >= 2.35" ;;
esac

do_install() {
	vbin bin/deckcraft
	vbin bin/deckcraft-cli
	cp -a share ${DESTDIR}/usr/
	vlicense share/doc/deckcraft/LICENSE-MIT
	vlicense share/doc/deckcraft/LICENSE-APACHE
}
