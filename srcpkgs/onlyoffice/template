# Template file for 'onlyoffice'
pkgname=onlyoffice
version=10.0.0
revision=1
archs="x86_64*"
depends="gtk+3 nss alsa-lib mesa libcups dbus-glib"
shlib_provides="virtodbc_r.so"
short_desc="Free office suite for documents, spreadsheets, and presentations"
maintainer="Pharacox <you@example.com>"
license="AGPL-3.0-only"
homepage="https://www.onlyoffice.com/desktop.aspx"
restricted=yes
repository=nonfree
nopie=yes
nostrip=yes
distfiles="https://github.com/ONLYOFFICE/DesktopEditors/releases/download/v${version}/DesktopEditors-x86_64.AppImage"
checksum="3e4668d44f6881d1d8873b38ea9c9fd81b9c77132facdb735bfebfe960edb745"
skip_extraction="DesktopEditors-x86_64.AppImage"
do_extract() {
	mkdir -p "${wrksrc}"
	cd "${wrksrc}"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/DesktopEditors-x86_64.AppImage" ./onlyoffice.AppImage
	chmod +x ./onlyoffice.AppImage
	./onlyoffice.AppImage --appimage-extract >/dev/null
	rm -f ./onlyoffice.AppImage
}
do_install() {
	vmkdir usr/lib/onlyoffice
	cp -a squashfs-root/* "${DESTDIR}/usr/lib/onlyoffice/"
	vmkdir usr/bin
	cat > "${DESTDIR}/usr/bin/${pkgname}" <<-EOF
	#!/bin/sh
	exec /usr/lib/onlyoffice/AppRun "\$@"
	EOF
	chmod 755 "${DESTDIR}/usr/bin/${pkgname}"
	vmkdir usr/share/applications
	desktop_file=$(find squashfs-root -maxdepth 1 -name '*.desktop' | head -n1)
	sed -e "s|Exec=.*|Exec=${pkgname} %U|" \
	    -e "s|Icon=.*|Icon=${pkgname}|" \
	    "${desktop_file}" > "${DESTDIR}/usr/share/applications/${pkgname}.desktop"
	vmkdir usr/share/icons/hicolor/256x256/apps
	icon_file=$(find squashfs-root -maxdepth 1 -name '*.png' | head -n1)
	[ -n "${icon_file}" ] && cp "${icon_file}" \
		"${DESTDIR}/usr/share/icons/hicolor/256x256/apps/${pkgname}.png"
}
