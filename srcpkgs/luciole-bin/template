# Patch ini cuma dibutuhin commit lama (lambda `this auto&&` gak punya `this`
# implisit). Upstream sudah memperbaikinya di commit baru, jadi patch di
# files/ dipasang HANYA kalau masih bisa dipasang bersih -- kalau enggak,
# dilewati. (Kalau ditaruh di patches/, build mati begitu auto-update naik
# ke commit yang sudah diperbaiki upstream.)
post_patch() {
	local p
	for p in ${FILESDIR}/*.patch; do
		if patch -Np1 --dry-run -s <"$p" >/dev/null 2>&1; then
			patch -Np1 -s <"$p"
		else
			msg_warn "${p##*/} tidak bisa dipasang, dilewati (sudah diperbaiki upstream?)\n"
		fi
	done
}

post_install() {
	vlicense LICENSE
}
