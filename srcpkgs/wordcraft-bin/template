# Template file for 'wordcraft-bin'
pkgname=wordcraft-bin
version=0.14.0
revision=1
archs="x86_64"
_name=wordcraft-${version}-linux-x86_64
wrksrc="${_name}"
# windowing (X11/Wayland, xkbcommon) and GPU (Vulkan/EGL) are dlopen'd at runtime
depends="libxkbcommon vulkan-loader libglvnd libX11 libXcursor libXi libXrandr
 wayland xdg-desktop-portal"
short_desc="Open-source native word processor, clean-room Word reimplementation (binary)"
maintainer="pharacox <solocco@users.noreply.github.com>"
license="MIT OR Apache-2.0"
homepage="https://github.com/storytold/wordcraft"
distfiles="${homepage}/releases/download/v${version}/${_name}.tar.gz"
checksum="3010da3d352d95256ec9a17a03966280a1d41ba09d0ebe569af23092d8b64987"
conflicts="wordcraft"
nostrip=yes # prebuilt, already stripped upstream

case "$XBPS_TARGET_MACHINE" in
	*-musl) broken="upstream binaries are built against glibc >= 2.35" ;;
esac

do_install() {
	vbin bin/wordcraft
	vbin bin/wordcraft-cli
	cp -a share ${DESTDIR}/usr/
	vlicense share/doc/wordcraft/LICENSE-MIT
	vlicense share/doc/wordcraft/LICENSE-APACHE
}
